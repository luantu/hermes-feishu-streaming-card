#!/bin/bash

# Hermes 自动升级脚本 (main 同步模式)
# 特性：自动检测脚本所在目录，无需硬编码路径，方便移植

set -euo pipefail

# ===================== 获取脚本所在目录 =====================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/config.yaml"

# ===================== 配置区 =====================
# 默认 Hermes 目录，可通过环境变量覆盖
HERMES_DIR="${HERMES_DIR:-$HOME/.hermes/hermes-agent}"

# ===================== 颜色输出 =====================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() {
    echo -e "${GREEN}[INFO] $*${NC}"
}

warn() {
    echo -e "${YELLOW}[WARN] $*${NC}"
}

error() {
    echo -e "${RED}[ERROR] $*${NC}"
    exit 1
}

# ===================== 检测 Python 解释器 =====================
detect_python() {
    # 1. 优先使用脚本目录下的虚拟环境
    if [[ -f "${SCRIPT_DIR}/venv/bin/python3" ]]; then
        echo "${SCRIPT_DIR}/venv/bin/python3"
        return 0
    fi
    
    # 2. 检查常见的 Hermes 虚拟环境
    local hermes_venv="${HERMES_DIR}/venv/bin/python3"
    if [[ -f "$hermes_venv" ]]; then
        echo "$hermes_venv"
        return 0
    fi
    
    # 3. 使用系统 Python
    if command -v python3 &> /dev/null; then
        echo "python3"
        return 0
    fi
    
    error "未找到 Python 解释器，请安装 Python 3 或创建虚拟环境"
}

PYTHON=$(detect_python)

# ===================== 检查配置文件 =====================
if [[ ! -f "$CONFIG_FILE" ]]; then
    warn "配置文件不存在: $CONFIG_FILE"
    warn "将使用默认配置"
fi

# ===================== 开始执行 =====================
info "================================================"
info "          Hermes 自动升级脚本 (main 同步模式)"
info "================================================"
info "脚本目录: ${SCRIPT_DIR}"
info "Python: ${PYTHON}"
info "配置文件: ${CONFIG_FILE}"
info "Hermes 目录: ${HERMES_DIR}"
info "================================================"

# 切换到脚本所在目录
cd "$SCRIPT_DIR" || error "切换目录失败"

# 1. 强制切到 master（确保不处于分离头）
info "1/7 切换到 main 分支"
git checkout main

# 2. 停止服务
info "2/7 停止服务..."
if [[ -f "$CONFIG_FILE" ]]; then
    $PYTHON -m hermes_feishu_card.cli stop --config "$CONFIG_FILE" || true
else
    warn "配置文件不存在，跳过停止服务"
fi

# 3. 保存本地所有修改（绝对不丢）
info "3/7 保存本地修改..."
if git status --porcelain | grep -q .; then
    git add .
    git commit -m "chore: save local changes before sync upstream" || true
    info "✅ 本地修改已保存"
else
    info "没有本地修改需要保存"
fi

# 4. 同步上游官方 master（核心！）
info "4/7 拉取并合并上游 main 最新代码..."
if git remote | grep -q upstream; then
    git fetch upstream
    git merge upstream/main --no-edit
else
    warn "未配置 upstream 远程仓库，跳过上游同步"
    warn "可通过以下命令添加上游仓库："
    warn "  git remote add upstream https://github.com/original/repo.git"
fi

# 5. 升级依赖
info "5/7 升级依赖..."
if command -v pip3 &> /dev/null; then
    pip3 install -e ".[test]" --upgrade --break-system-packages || warn "依赖升级失败（可忽略）"
else
    warn "未找到 pip3，跳过依赖升级"
fi

# 6. 安装 & 检查
info "6/7 执行安装与环境检查..."
if [[ -d "$HERMES_DIR" ]]; then
    $PYTHON -m hermes_feishu_card.cli doctor --config "$CONFIG_FILE" --hermes-dir "$HERMES_DIR" || warn "环境检查失败"
    $PYTHON -m hermes_feishu_card.cli install --hermes-dir "$HERMES_DIR" --yes || warn "安装失败"
else
    warn "Hermes 目录不存在: $HERMES_DIR"
    warn "跳过安装步骤"
fi

# 7. 启动服务
info "7/7 启动服务..."
if [[ -f "$CONFIG_FILE" ]]; then
    $PYTHON -m hermes_feishu_card.cli start --config "$CONFIG_FILE" || error "启动服务失败"
else
    warn "配置文件不存在，跳过启动服务"
fi

info "================================================"
info "✅ 同步完成！当前已是上游最新 main 代码"
info "✅ 你可直接执行：git push 推送到你的仓库"
info "================================================"
