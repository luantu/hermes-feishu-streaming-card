#!/bin/bash
set -euo pipefail

# ===================== 配置区 =====================
CONFIG_FILE="config.yaml"
HERMES_DIR="$HOME/.hermes/hermes-agent"
# ==================================================

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() {
    echo -e "${GREEN}[INFO] $*${NC}"
}

warn() {
    echo -e "${YELLOW}[WARN] $*${NC}"
}

error() {
    echo -e "${RED}[ERROR] $*${NC}"
}

# 开始
info "================================================"
info "          Hermes 自动升级脚本 (master 同步模式)"
info "================================================"

# 1. 强制切到 master（确保不处于分离头）
info "1/7 切换到 master 分支"
git checkout master

# 2. 停止服务
info "2/7 停止服务..."
python3 -m hermes_feishu_card.cli stop --config "${CONFIG_FILE}" || true

# 3. 保存本地所有修改（绝对不丢）
info "3/7 保存本地修改..."
if git status --porcelain | grep -q .; then
    git add .
    git commit -m "chore: save local changes before sync upstream"
    info "✅ 本地修改已保存"
fi

# 4. 同步上游官方 master（核心！）
info "4/7 拉取并合并上游 master 最新代码..."
git fetch upstream
git merge upstream/master --no-edit

# 5. 升级依赖
info "5/7 升级依赖..."
pip3 install -e ".[test]" --upgrade --break-system-packages

# 6. 安装 & 检查
info "6/7 执行安装与环境检查..."
python3 -m hermes_feishu_card.cli doctor --config "${CONFIG_FILE}" --hermes-dir "${HERMES_DIR}"
python3 -m hermes_feishu_card.cli install --hermes-dir "${HERMES_DIR}" --yes

# 7. 启动服务
info "7/7 启动服务..."
python3 -m hermes_feishu_card.cli start --config "${CONFIG_FILE}"

info "================================================"
info "✅ 同步完成！当前已是上游最新 master 代码"
info "✅ 你可直接执行：git push 推送到你的仓库"
info "================================================"