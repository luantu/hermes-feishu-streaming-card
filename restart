#!/bin/bash

# 重启脚本：严格顺序执行，失败立即退出，友好提示
# 作用：重启 hermes_feishu_card 服务
# 特性：自动检测脚本所在目录，无需硬编码路径，方便移植

# 开启严格模式：任意命令执行失败(非0退出码)，脚本立即停止执行
set -euo pipefail

# ===================== 获取脚本所在目录 =====================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/config.yaml"

# ===================== 颜色定义（让提示更友好） =====================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # 无颜色

# 成功提示函数
info() {
    echo -e "${GREEN}[INFO] $*${NC}"
}

# 警告提示函数
warn() {
    echo -e "${YELLOW}[WARN] $*${NC}"
}

# 错误提示函数
error() {
    echo -e "${RED}[ERROR] $*${NC}"
    exit 1
}

# ===================== 检测 Python 解释器 =====================
detect_python() {
    # 1. 优先使用脚本目录下的虚拟环境
    if [[ -f "${SCRIPT_DIR}/venv/bin/python3" ]]; then
        echo "${SCRIPT_DIR}/venv/bin/python3"
        return 0
    fi
    
    # 2. 检查常见的 Hermes 虚拟环境
    local hermes_venv="$HOME/.hermes/hermes-agent/venv/bin/python3"
    if [[ -f "$hermes_venv" ]]; then
        echo "$hermes_venv"
        return 0
    fi
    
    # 3. 使用系统 Python
    if command -v python3 &> /dev/null; then
        echo "python3"
        return 0
    fi
    
    error "未找到 Python 解释器，请安装 Python 3 或创建虚拟环境"
}

PYTHON=$(detect_python)

# ===================== 检查配置文件 =====================
if [[ ! -f "$CONFIG_FILE" ]]; then
    error "配置文件不存在: $CONFIG_FILE"
fi

# ===================== 开始执行重启流程 =====================
info "========== 开始执行 feishu-card 重启任务 =========="
info "脚本目录: ${SCRIPT_DIR}"
info "Python: ${PYTHON}"
info "配置文件: ${CONFIG_FILE}"

# 1. 切换目录
info "正在切换工作目录..."
cd "$SCRIPT_DIR" || error "切换目录失败"
info "当前工作目录: $(pwd)"

# 2. 清理 Python 缓存
info "正在清理 Python 缓存..."
rm -rf "${SCRIPT_DIR}/hermes_feishu_card/__pycache__" || warn "删除 Python 缓存失败（可忽略）"

# 3. 查看当前状态
info "正在查询服务当前状态..."
$PYTHON -m hermes_feishu_card.cli status --config "$CONFIG_FILE" || warn "查询服务状态失败（可能服务未运行）"

# 4. 停止服务
info "正在停止服务..."
$PYTHON -m hermes_feishu_card.cli stop --config "$CONFIG_FILE" || warn "停止服务失败（可能服务未运行）"

# 5. 再次清理缓存
info "正在清理 Python 缓存..."
rm -rf "${SCRIPT_DIR}/hermes_feishu_card/__pycache__" || warn "删除 Python 缓存失败（可忽略）"

# 6. 启动服务
info "正在启动服务..."
$PYTHON -m hermes_feishu_card.cli start --config "$CONFIG_FILE" || error "启动服务失败"

# 7. 再次查看状态，确认启动成功
info "正在验证服务启动状态..."
sleep 2  # 等待服务启动
$PYTHON -m hermes_feishu_card.cli status --config "$CONFIG_FILE" || error "服务启动后状态检查失败"

# ===================== 执行完成 =====================
info "=================================================="
info "✅  feishu-card 服务重启全部执行成功！"
info "=================================================="
